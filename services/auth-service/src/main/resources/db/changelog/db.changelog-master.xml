    <include file="db/changelog/v1.0.0/060-create-password-reset-tokens.xml"/>
    <!-- Phase 13: the purpose discriminator that lets one token table serve both the reset and the
         forced-change flow, plus the SECURITY DEFINER tenant lookup both of them need because they
         are public and therefore arrive with no tenant GUC. Immediately after 060 because it alters
         that table and nothing between the two touches it. -->
    <include file="db/changelog/v1.0.0/061-password-token-purpose.xml"/>
    <include file="db/changelog/v1.0.0/070-create-password-history.xml"/>
    <include file="db/changelog/v1.0.0/080-add-must-change-password.xml"/>
    <include file="db/changelog/v1.0.0/053-fix-rls-tenant-guc-policies.xml"/>
    <!-- After 041/042's blanket OWNER/TENANT_ADMIN grants, so the orphan they propagate is
         removed rather than re-granted on the next run. -->
    <include file="db/changelog/v1.0.0/054-retire-orphan-pos-order-void.xml"/>
    <!-- Phase 13: WAITER role + the tenant-administration authority split. Before the seeds, so a
         seed changeset may reference WAITER. -->
    <include file="db/changelog/v1.0.0/055-waiter-role-and-tenant-admin-authority.xml"/>
    <include file="db/changelog/v1.0.0/900-seed-auth-dev-data.xml"/>
    <include file="db/changelog/v1.0.0/902-seed-purchasing-demo-users.xml"/>
    <!-- Phase 13: duplicate repair, the one-active-role-per-branch index, and is_primary.
         Deliberately AFTER the seeds despite the number. The is_primary backfill has to observe
         every user_branch_roles row the changelog itself writes; run before 900/902 it would leave
         every seeded persona with no primary on a fresh database, which is not what "backfill"
         means and would make the fresh-install and upgrade paths behave differently. On any
         database that has already run the seeds, position here is immaterial — Liquibase applies a
         changeset once. -->
    <include file="db/changelog/v1.0.0/056-one-active-role-per-branch.xml"/>
    <!-- Phase 13: OWNER and TENANT_ADMIN back to holding the whole catalogue. Must run AFTER every
         changeset that declares a permission (049 and 055 among them), because it grants by
         SELECTing from `permissions` and can only grant what is already there — which is exactly
         the mistake it exists to repair. Last include, so any future permission changeset added
         above it is picked up automatically. -->
    <include file="db/changelog/v1.0.0/057-repair-administration-role-grant-drift.xml"/>
    <!-- Phase 13 (13-11): duplicate repair, then per-tenant CASE-INSENSITIVE email uniqueness over
         live rows, then the list-supporting index. AFTER the 900-series seeds for the same reason
         056 is: the repair has to observe every users row the changelog itself writes, and running
         it before the seeds would make the fresh-install and upgrade paths converge differently.
         Numbered 058 because 13-07 had already taken 057. -->
    <include file="db/changelog/v1.0.0/058-users-tenant-email-uniqueness.xml"/>
    <!-- 15-01: audit.log.view, the gate on the tenant-facing audit read API. Grants OWNER and
         TENANT_ADMIN explicitly rather than relying on 057 above, which is point-in-time like
         every other blanket grant in this changelog and retro-grants nothing added after it. -->
    <include file="db/changelog/v1.0.0/059-audit-log-view-permission.xml"/>
    <!-- 16a-01: the cross-tenant candidate lookup behind email-first login. Last, and it must stay
         after 058: it indexes `lower(email)` over the same live-row predicate 058's unique index
         uses, and the repair 058 performs is what guarantees the lookup cannot return two rows for
         one (tenant, address) pair. -->
    <include file="db/changelog/v1.0.0/081-login-candidate-lookup.xml"/>
    <!-- 18b-01: file.view/upload/manage — file-service enforced NOTHING beyond authenticated(), so
         any token in the tenant could delete any file — plus removal of the FINANCE_VIEWER grants
         that name a role no non-seed database has. Grants explicitly, like 055 and 059, because
         057's catalogue-wide repair is point-in-time and retro-grants nothing added after it. -->
    <include file="db/changelog/v1.0.0/082-file-permissions-and-finance-viewer-role.xml"/>
    <!-- 19b-01: pos.tables.admin — the dining-table CATALOGUE gate. Separate from the existing
         pos.tables.manage, which WAITER holds on purpose (055) so a waiter can seat a table;
         reusing it for create/rename/retire would have let every waiter re-lay the floor plan.
         Grants explicitly to OWNER/TENANT_ADMIN/MANAGER for the same point-in-time reason 055,
         059 and 082 give, and verifies the grant landed rather than leaving a permission nobody
         holds. -->
    <include file="db/changelog/v1.0.0/083-pos-tables-admin-permission.xml"/>
    <!-- 16b-01: the `scope` discriminator that lets a tenant-less platform session live in
         `refresh_sessions` without a NULL tenant id (which FORCE RLS would make permanently
         invisible) and without a second SECURITY DEFINER lookup function. Deliberately touches NO
         function: changeset 052's `auth_lookup_refresh_tenant` keeps working unmodified because the
         platform sentinel is a real, non-NULL uuid. -->
    <include file="db/changelog/v1.0.0/084-platform-refresh-scope.xml"/>
    <!-- 28-01: pos.terminals.admin — the POS terminal PROFILE gate (name, station set, menu scope).
         Held by OWNER/TENANT_ADMIN/MANAGER, the same people who already own the floor plan and the
         menu; a cashier uses a terminal and does not get to re-scope it. Granted explicitly for the
         point-in-time reason 055, 059, 082 and 083 each give, and verified, because a permission
         nobody holds is a 403 that looks deliberate. Lands here rather than in plan 28-04 so that
         the permission exists before PosTerminalController references it — PermissionCatalogClosureTest
         fails the build otherwise. -->
    <include file="db/changelog/v1.0.0/085-pos-terminals-admin-permission.xml"/>
    <!-- 28-01: user_station_assignments — which stations a person works, per branch (D-28-02). The
         set is resolved at token-mint time and rides the access token's existing `attributes` map,
         so no downstream service needs a cross-service call or a projection table to know it. Stores
         the station CODE, not an id: the code is already the routing key on tickets and on the KDS
         socket, and it cannot go stale because a station's code cannot be renamed. ENABLEd AND
         FORCEd, like 041/050/056/058 — an ENABLE-only tenant table is the exact defect 17b closed. -->
    <include file="db/changelog/v1.0.0/086-user-station-assignments.xml"/>
    <!-- The last raw-cast tenant GUC policy in auth_db. 053 converted the six that existed then;
         086 ran after it and created user_station_assignments' policy in the very form 053 exists
         to remove. Must stay after 086, which creates the policy this re-creates. -->
    <include file="db/changelog/v1.0.0/087-rls-policy-null-safe-guc.xml"/>
    <!-- S1-06: pos.printers.admin — the branch printer registry and print-agent enrolment were
         gated on `branch.manage` ("create, update and deactivate branches"), which OWNER and
         TENANT_ADMIN hold and a branch MANAGER does not. Measured live: the manager who plugs the
         printer in got a 403 on their own branch's receipt-config. Printers are branch equipment
         catalogue, like tables (083) and till profiles (085), so they get the same holder set and
         the same explicit, verified grant rather than a widening of `branch.manage`. -->
    <include file="db/changelog/v1.0.0/088-pos-printers-admin-permission.xml"/>
    <!-- S1-09: ops.health.view — the operator service-health screen. The register found a manager
         getting 503 SERVICE_UNAVAILABLE on the till, the KDS, the customer file and payroll at
         once, with no screen anywhere in the product that could say which service was down or when
         it was last reachable. Held by OWNER and TENANT_ADMIN, the same two personas /app/settings
         already admits; the cashier learns what they need from the till's own outage banner rather
         than from a fleet inventory. Explicit and verified for the reason 085 and 088 give. -->
    <include file="db/changelog/v1.0.0/089-ops-health-view-permission.xml"/>
    <!-- F11: pos.till.open.other — a duty manager counting the float into a NAMED cashier's
         drawer. openTill derived the cashier from the caller's own subject, so the drawer belonged
         to whoever pressed the button and a supplied cashierId was silently dropped (measured: the
         409 named the manager's own id). `pos.till.open` stays with CASHIER — opening your own
         drawer is normal work — and the supervisory act gets its own code, held by the three roles
         that already review somebody else's till. Explicit and verified for the reason 085, 088 and
         089 give. -->
    <include file="db/changelog/v1.0.0/090-pos-till-open-other-permission.xml"/>
    <!-- F16: pos.tax.manage — the tenant's sales-tax catalogue. There was no tax screen anywhere
         in the product (measured: /app/settings/tax, /settings/taxes, /finance/tax and /menu/tax
         all 404 for the OWNER), so a Rs 1,657.00 check was taxed 1.5% — only two of its lines had
         ever been given a rate. Deciding a dish is standard-rated stays `pos.menu.manage`, which
         MANAGER holds; deciding that standard rate MEANS 17% is a statutory fact about the
         business that mis-states the return rather than one bill, so it gets its own code held by
         OWNER and TENANT_ADMIN. Same split 083 made for tables and 085 for terminals; explicit and
         verified for the reason 088, 089 and 090 give. -->
    <include file="db/changelog/v1.0.0/091-pos-tax-manage-permission.xml"/>
    <!-- S3: tenant-scoped custom roles. `roles` could already hold a tenant's own row;
         `role_permissions` could not, so two tenants defining the same role code would have shared
         one set of grants. Adds the tenant column, the matching FORCE RLS policy, and the write
         grants the role builder needs. No existing row changes: every seeded grant stays
         tenant_id NULL, which is what "platform-defined, every tenant sees it" means here. -->
    <include file="db/changelog/v1.0.0/092-tenant-custom-roles.xml"/>
    <!-- F20: pos.service_charge.manage - a branch's service-charge percentage. `Service charge
         Rs 0.00` printed on the charge page and on every guest's receipt while nothing in the
         product could make the figure move (measured: service_charge_paisa non-zero on 0 of 195
         orders). Pricing one dish stays `pos.menu.manage`, which MANAGER holds; deciding that
         every check in the building grows by 5% - with no reason code and no per-check record of
         who said so - gets its own code held by OWNER and TENANT_ADMIN. Same split 083 made for
         tables, 085 for terminals and 091 for tax; explicit and verified for the reason 088, 089,
         090 and 091 give. -->
    <include file="db/changelog/v1.0.0/093-pos-service-charge-manage-permission.xml"/>

</databaseChangeLog>
