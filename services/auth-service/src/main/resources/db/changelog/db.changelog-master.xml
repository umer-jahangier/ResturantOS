    <!-- The 045/046 numbers are used twice: this branch and the phase-12 branch each picked the
         next two free prefixes independently. Harmless — Liquibase keys history on
         (id, author, filename), and all four changeset ids are distinct — so renumbering would
         only invalidate history on databases that already ran them. Kept as-is deliberately. -->
    <include file="db/changelog/v1.0.0/045-reporting-permissions.xml"/>
    <include file="db/changelog/v1.0.0/046-nlq-permissions.xml"/>
    <!-- Phase 9 gap closure: crm-service's @PreAuthorize codes were never in the catalog. -->
    <include file="db/changelog/v1.0.0/047-crm-permissions.xml"/>
    <include file="db/changelog/v1.0.0/048-cashier-crm-manage.xml"/>
    <include file="db/changelog/v1.0.0/049-repair-permission-catalog-drift.xml"/>
    <!-- Phase 11 HR permissions. Filename is distinct from prod's 045-* above; Liquibase keys on
         (id, author, filename), so the reused 045 prefix is harmless (same rationale as above). -->
    <include file="db/changelog/v1.0.0/045-hr-permissions.xml"/>
    <include file="db/changelog/v1.0.0/040-create-user-branch-roles.xml"/>
