<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Make file_metadata's tenant_isolation policy answer, rather than throw, on a connection that
      carries no tenant.

      011 wrote it as a raw cast of the GUC. The GUC's "no tenant" value is the EMPTY STRING — that
      is what TenantAwareDataSource writes on every tenantless checkout and on every connection
      reset at close — and casting the empty string to uuid raises "invalid input syntax for type
      uuid". So a legitimately tenantless read (an actuator probe, a platform-scoped query, a job
      that has not adopted a tenant) failed with a cast error instead of returning nothing.

      NULLIF(..., '') turns the empty string into NULL, and `tenant_id = NULL` is NULL, which is not
      true, so the row is excluded. Same fail-closed outcome, expressed as an answer.

      Behaviour for a tenant-scoped connection is unchanged: a non-empty GUC passes through NULLIF
      untouched and the comparison is exactly what it was.

      Written as a NEW changeset rather than an edit to 011: that one has been applied, and
      Liquibase would see a checksum change. 011 stays as the historical record of what was
      created; this is the record of the correction. Same shape as user-service's
      013-rls-policy-null-safe-guc.xml and auth-service's 053.

      RLS is left ENABLEd and FORCEd, and the file_service grants untouched, exactly as 011 set
      them — this changeset touches the USING predicate and nothing else.
    -->
    <changeSet id="file-1.0.0-012-rls-policy-null-safe-guc" author="restaurantos-agent">
        <sql splitStatements="true" endDelimiter=";">
            DROP POLICY IF EXISTS tenant_isolation ON file_metadata;
            CREATE POLICY tenant_isolation ON file_metadata
                USING (tenant_id = NULLIF(current_setting('app.current_tenant_id', true), '')::uuid);
        </sql>
        <rollback>
            <!-- The raw cast below is deliberate and correct: rolling back means restoring exactly
                 what 011 created, cast error and all. -->
            <sql splitStatements="true" endDelimiter=";">
                DROP POLICY IF EXISTS tenant_isolation ON file_metadata;
                CREATE POLICY tenant_isolation ON file_metadata
                    USING (tenant_id = current_setting('app.current_tenant_id', true)::uuid);
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
