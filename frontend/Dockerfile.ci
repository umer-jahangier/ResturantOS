# syntax=docker/dockerfile:1
# Per-environment frontend image.
#
# WHY THIS IS BUILT TWICE (once for dev, once for prod), unlike every other image:
# Next.js INLINES NEXT_PUBLIC_* at build time — it is not read from the pod's
# environment at runtime. And it cannot simply be made relative: lib/env.ts uses
# `?? "http://localhost:8080"`, and lib/server/resolve-tenant-brand.ts performs a
# SERVER-side fetch inside the pod, where a relative "/api/..." has no origin to
# resolve against and would throw. So the public origin has to be compiled in, and
# each hostname needs its own image.
FROM node:22-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# Supplied by .github/workflows/deploy.yml as --build-arg, per environment.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_WS_BASE_URL
ARG NEXT_PUBLIC_DEFAULT_TENANT_SLUG=terrace
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_WS_BASE_URL=$NEXT_PUBLIC_WS_BASE_URL
ENV NEXT_PUBLIC_DEFAULT_TENANT_SLUG=$NEXT_PUBLIC_DEFAULT_TENANT_SLUG
ENV NEXT_TELEMETRY_DISABLED=1
# Fail the build loudly rather than silently baking in the localhost fallback,
# which would produce an image that looks fine and cannot reach any API.
RUN test -n "$NEXT_PUBLIC_API_BASE_URL" || (echo "NEXT_PUBLIC_API_BASE_URL build-arg is required" && exit 1)
RUN pnpm build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
CMD ["node", "server.js"]
