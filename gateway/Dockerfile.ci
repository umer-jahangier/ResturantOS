# Runtime-only image. The jar is built ONCE by the CI reactor build
# (`mvn -DskipTests package`) and copied in here — this file never runs Maven.
#
# WHY: every services/*/Dockerfile builds the ENTIRE Maven reactor from scratch.
# Eighteen of those in one pipeline is eighteen full builds of shared-lib and
# every dependency. One reactor build + eighteen COPYs is the same artefact for
# a fraction of the wall clock.
#
# No wget/curl is installed: Kubernetes probes are httpGet, performed by the
# kubelet from outside the container, so nothing in-image needs to speak HTTP.
# Build context is gateway/ — see .github/workflows/deploy.yml.
FROM eclipse-temurin:25-jre

RUN groupadd --system --gid 1001 app \
 && useradd --system --uid 1001 --gid app --no-create-home app

WORKDIR /app
COPY target/gateway-*.jar app.jar
RUN chown -R app:app /app
USER app

EXPOSE 8080
# MaxRAMPercentage (not -Xmx) so the heap tracks the container limit set in the
# Deployment; SerialGC because at this pod density the parallel collectors'
# per-JVM thread pools cost more than they return.
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+UseSerialGC -Xss512k -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["java","-jar","/app/app.jar"]
